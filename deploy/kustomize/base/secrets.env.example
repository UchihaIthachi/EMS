# Copy to secrets.env (git-ignored). Keys match what the chart's workloads read.
MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_EMPLOYEE_PASSWORD=change-me-employee
MYSQL_DEPARTMENT_PASSWORD=change-me-department
RABBITMQ_PASSWORD=change-me-rabbit
# KEDA reads the queue with this URI (same password as above)
RABBITMQ_AMQP_URI=amqp://ems:change-me-rabbit@rabbitmq.ems.svc:5672/
